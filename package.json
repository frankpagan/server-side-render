{
  "name": "@cocreate/server-side-render",
  "version": "1.21.0",
  "description": "High-performance, stateless server-side rendering (SSR) engine with recursive HTML template parsing, multi-source data resolution, and automated circular dependency protection.",
  "keywords": [
    "server-side-rendering",
    "ssr-engine",
    "html-parsing",
    "recursive-rendering",
    "stateless-utility",
    "template-interpolation",
    "metadata-merging",
    "circular-dependency-prevention",
    "i18n-ssr",
    "cocreate-module"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "High-performance, stateless server-side rendering (SSR) engine with recursive HTML template parsing, multi-source data resolution, and automated circular dependency protection.",
      "source": "src/index.js",
      "declarative": {
        "attributes": [
          {
            "name": "actions"
          },
          {
            "name": "array"
          },
          {
            "name": "class"
          },
          {
            "name": "component"
          },
          {
            "name": "content"
          },
          {
            "name": "data-color-scheme"
          },
          {
            "name": "error"
          },
          {
            "name": "filter"
          },
          {
            "name": "href"
          },
          {
            "name": "i18n"
          },
          {
            "name": "key"
          },
          {
            "name": "media"
          },
          {
            "name": "name"
          },
          {
            "name": "object"
          },
          {
            "name": "plugin"
          },
          {
            "name": "rel"
          },
          {
            "name": "render-error"
          },
          {
            "name": "render-query"
          },
          {
            "name": "rendered"
          },
          {
            "name": "src"
          },
          {
            "name": "state-id"
          },
          {
            "name": "state-overwrite"
          },
          {
            "name": "type"
          }
        ]
      },
      "api": {
        "exports": [
          "HTML"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-server-side-render.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-server-side-render/issues"
  },
  "homepage": "https://cocreate.app/docs/server-side-render",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.54.0"
  }
}
